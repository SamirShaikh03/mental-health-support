# WellSetu Backend Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# SERVER CONFIGURATION
# ===========================================
NODE_ENV=development
PORT=5000
API_VERSION=v1

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# MongoDB connection string
# For local: mongodb://localhost:27017/wellsetu
# For Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/wellsetu
MONGODB_URI=mongodb://localhost:27017/wellsetu
MONGODB_URI_TEST=mongodb://localhost:27017/wellsetu_test

# ===========================================
# JWT AUTHENTICATION
# ===========================================
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# Refresh token settings
JWT_REFRESH_SECRET=your_refresh_token_secret_change_this_in_production
JWT_REFRESH_EXPIRES_IN=30d

# ===========================================
# AI CHAT INTEGRATION
# ===========================================
# OpenAI API Key (for GPT models)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Default AI provider: 'openai' or 'gemini'
DEFAULT_AI_PROVIDER=gemini

# ===========================================
# EMAIL CONFIGURATION (for notifications)
# ===========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password
EMAIL_FROM=WellSetu <noreply@wellsetu.com>

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# SECURITY
# ===========================================
# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Bcrypt salt rounds
BCRYPT_SALT_ROUNDS=12

# ===========================================
# FILE UPLOAD
# ===========================================
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=debug
LOG_FILE=./logs/app.log

# ===========================================
# FRONTEND URL (for email links, etc.)
# ===========================================
FRONTEND_URL=http://localhost:3000

# ===========================================
# ADMIN CREDENTIALS (initial setup)
# ===========================================
ADMIN_EMAIL=admin@wellsetu.com
ADMIN_PASSWORD=ChangeThisSecurePassword123!
