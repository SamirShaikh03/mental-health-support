{
  "version": 2,
  "buildCommand": "cd front-end && npm install && npm run build",
  "outputDirectory": "front-end/build",
  "installCommand": "cd front-end && npm install",
  "framework": null,
  "builds": [
    {
      "src": "front-end/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "build" }
    },
    {
      "src": "front-end/pages/api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/front-end/pages/api/$1"
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/front-end/build/index.html" }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}